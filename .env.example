# =============================================================================
# BorrowDesk - Robinhood Chain mainnet
# Copy to .env and fill in. NEVER commit .env or share your private key in chat.
# =============================================================================

# Deployer private key (0x-prefixed). This wallet becomes market owner.
PRIVATE_KEY=

# Robinhood Chain RPC
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: seed USDG liquidity at deploy time (human units, 6 decimals onchain)
# Example: 500 = $500 USDG
USDG_LIQUIDITY=500

# Filled automatically after deploy - also written to deployments/robinhood.json
NEXT_PUBLIC_BORROWDESK_MARKET=
NEXT_PUBLIC_BORROWDESK_LENS=
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Reown (WalletConnect) AppKit project ID - https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
